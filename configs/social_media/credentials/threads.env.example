# Run `threads-token authorize` from the installed MediaOverload environment.
# It uses Threads OAuth directly and saves the token here. For a pre-existing
# short-lived token, use `threads-token exchange` instead.
THREADS_ACCESS_TOKEN=your_threads_user_access_token_here
# Optional Unix expiry timestamp returned by Meta. When present, the publisher
# uses it to refresh the token near expiry; without it, Meta validates the token.
THREADS_ACCESS_TOKEN_EXPIRES_AT=

# Set by the exchange command; the publisher verifies this account id.
# THREADS_USER_ID=your_threads_user_id_here

# Optional when Cloudinary is not configured. Meta must be able to fetch files
# from this public URL, using the same filename as the local media artifact.
# THREADS_MEDIA_BASE_URL=https://your-domain.com/media
