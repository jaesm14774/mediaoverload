{
  "name": "anima_anime",
  "media_types": ["image"],
  "workflow_path": "../configs/workflow/anima_anime.json",
  "summary": "Legacy Anima text-to-image workflow with built-in anime upscaling.",
  "required_assets": [
    {
      "name": "anima-preview2.safetensors",
      "kind": "unet",
      "target_dir": "ComfyUI/models/unet/anima",
      "source": "comfyui_model_store"
    },
    {
      "name": "qwen_image_vae.safetensors",
      "kind": "vae",
      "target_dir": "ComfyUI/models/vae/anima",
      "source": "comfyui_model_store"
    },
    {
      "name": "qwen_3_06b_base.safetensors",
      "kind": "clip",
      "target_dir": "ComfyUI/models/text_encoders/anima",
      "source": "comfyui_model_store"
    },
    {
      "name": "4x-AnimeSharp.pth",
      "kind": "upscale_model",
      "target_dir": "ComfyUI/models/upscale_models",
      "source": "comfyui_model_store"
    }
  ],
  "recommended_defaults": {
    "width": 1024,
    "height": 1024,
    "steps": 25,
    "cfg": 3.5
  }
}
