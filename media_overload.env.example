# MediaOverload 主環境變數配置範例
# 複製此檔案為 media_overload.env 並填入實際值

# Google Gemini API (可選)
gemini_api_token=your_gemini_api_key_here

# Discord 審核機器人設定
discord_review_bot_token=your_discord_bot_token_here
discord_review_channel_id=your_discord_channel_id_here
discord_review_timeout_seconds=3600

# MySQL 資料庫設定
mysql_host=localhost
mysql_port=3306
mysql_user=your_mysql_username
mysql_password=your_mysql_password
mysql_db_name=your_database_name

# OpenRouter API Token（與下方 AGENTIC_* 一併使用）
open_router_token=your_openrouter_token_here
AGENTIC_LLM_MODE=llm
AGENTIC_TEXT_MODEL_PROVIDER=openrouter
# 固定單一模型，或留空／設 AGENTIC_OPENROUTER_TEXT_MODEL_STRATEGY=free_pool 改走免費池
AGENTIC_TEXT_MODEL=qwen/qwen3.6-plus:free
AGENTIC_VISION_MODEL_PROVIDER=openrouter
AGENTIC_VISION_MODEL=qwen/qwen3.6-plus:free
# AGENTIC_RANDOM_MODELS=true 時在未使用 free_pool 下於啟動時抽一個免費文字／視覺模型
# AGENTIC_OPENROUTER_ROTATE_TEXT_MODELS=false 時不重試換其他免費模型（僅用候選清單第一個）
# AGENTIC_OPENROUTER_MAX_TEXT_MODELS_PER_CALL=3 限制單次請求最多嘗試幾個不同模型（0＝不限制）
# OpenRouter 全數失敗後的備援（需 gemini_api_token）
# AGENTIC_TEXT_FALLBACK_PROVIDER=gemini
# AGENTIC_TEXT_FALLBACK_MODEL=gemini-flash-lite-latest

# Ollama 設定 (可選，如果使用本地模型)
# OLLAMA_API_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# Cloudinary 媒體上傳（IG Graph API 需公開 URL，二選一：Cloudinary 或 IG_GRAPH_MEDIA_BASE_URL）
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ComfyUI 設定
# COMFYUI_API_URL=http://localhost:8188

# 影片生成設定 (可選)
# VIDEO_GENERATION_ENABLED=true

# Scheduler 設定
SCHEDULER_ENABLED=true
SCHEDULER_CHARACTER=kirby
# SCHEDULER_CONFIG=
SCHEDULER_MODE=interval
SCHEDULER_INTERVAL_HOURS=24
# SCHEDULER_DAILY_TIME=09:00
SCHEDULER_RUN_IMMEDIATELY=false
SCHEDULER_PROMPT=
SCHEDULER_ENABLE_REVIEW_LOOP=true
SCHEDULER_PUBLISH_AFTER_GENERATE=true
SCHEDULER_DRY_RUN_PUBLISH=false
# SCHEDULER_REVIEW_NOTES=
# SCHEDULER_OUTPUT_DIR=
# SCHEDULER_PREFERRED_GENERATION_TYPE=

