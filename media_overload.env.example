# MediaOverload 主環境變數配置範例
# 複製此檔案為 media_overload.env 並填入實際值

# Google Gemini API (可選)
gemini_api_token=your_gemini_api_key_here
# OpenAI-compatible auxiliary providers (optional; only used after OpenRouter fails)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_key_here

# Generated media can be attached to vision models for visual caption grounding.
# Keep this restricted to the dedicated generated-output root.
AGENTIC_ALLOWED_IMAGE_ROOTS=D:/MediaOverload/output

# Discord 審核機器人設定
discord_review_bot_token=your_discord_bot_token_here
discord_review_channel_id=your_discord_channel_id_here
# Prefer immutable Discord user IDs. Names are kept only as a migration fallback.
discord_review_allowed_user_ids=your_discord_user_id
discord_review_allowed_users=your_discord_username_or_id
# Optional comma-separated roots for review artifacts outside the run output root.
discord_review_allowed_roots=
discord_review_timeout_seconds=3600

# MySQL 資料庫設定
mysql_host=localhost
mysql_port=3306
mysql_user=your_mysql_username
mysql_password=your_mysql_password
mysql_db_name=your_database_name

# OpenRouter API Token（與下方 AGENTIC_* 一併使用）
open_router_token=your_openrouter_token_here
AGENTIC_LLM_MODE=llm
AGENTIC_TEXT_MODEL_PROVIDER=openrouter
# 留空即使用 repo 內已測試的固定免費模型池；每次請求會隨機挑選
AGENTIC_TEXT_MODEL=
AGENTIC_VISION_MODEL_PROVIDER=openrouter
AGENTIC_VISION_MODEL=
AGENTIC_RANDOM_MODELS=true
AGENTIC_OPENROUTER_DISCOVER_MODELS=false
AGENTIC_OPENROUTER_MODEL_CONFIG=configs/openrouter_models.yaml
AGENTIC_OPENROUTER_TEXT_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AGENTIC_OPENROUTER_VISION_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-nano-12b-v2-vl:free
AGENTIC_PROVIDER_FALLBACK_ENABLED=true
AGENTIC_TEXT_FALLBACK_PROVIDERS=groq,mistral
AGENTIC_TEXT_FALLBACK_MODELS=llama-3.3-70b-versatile,mistral-small-latest
AGENTIC_VISION_FALLBACK_PROVIDERS=gemini,groq
AGENTIC_VISION_FALLBACK_MODELS=gemini-3.5-flash,qwen/qwen3.6-27b
# The fallback chain skips any provider whose API key is not configured.

# Ollama 設定 (可選，如果使用本地模型)
# OLLAMA_API_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# Cloudinary 媒體上傳（IG Graph API 需公開 URL，二選一：Cloudinary 或 IG_GRAPH_MEDIA_BASE_URL）
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ComfyUI 設定
# COMFYUI_API_URL=http://localhost:8188

# 影片生成設定 (可選)
# VIDEO_GENERATION_ENABLED=true
